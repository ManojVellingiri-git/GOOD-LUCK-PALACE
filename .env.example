# Database Connection (Defaults to local SQLite if omitted)
# For PostgreSQL in production, format: postgresql://user:password@host:5432/goodluck_palace
DATABASE_URL=sqlite:///./goodluck_palace.db

# JWT Authentication Secret (Generate a strong random 64-character secret in production)
JWT_SECRET=goodluck_palace_jwt_secret_super_secure_key_1983_gandhipuram_coimbatore
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Store Owner / Super Admin Email (Strictly locked: only this email receives admin permissions)
ADMIN_EMAIL=owner@goodluckpalace.com

# Razorpay Online Payment Gateway Credentials
# Replace with your live credentials from dashboard.razorpay.com before production launch
RAZORPAY_KEY_ID=rzp_test_goodluck1983
RAZORPAY_KEY_SECRET=goodluck_test_secret_key
RAZORPAY_WEBHOOK_SECRET=goodluck_webhook_secret_key_1983

# Resend Transactional Email Service
# Get an API key from https://resend.com and verify your domain (e.g., mail.goodluckpalace.com)
RESEND_API_KEY=re_test_mock_resend_key_goodluck_palace
RESEND_FROM_EMAIL=orders@goodluckpalace.com

# Store Front-Facing WhatsApp & Contact Configuration
STORE_WHATSAPP_NUMBER=919442236592
STORE_PHONE=+91 422 223 6592
STORE_EMAIL=orders@goodluckpalace.com

# Server Port Settings
PORT=8001
HOST=127.0.0.1
